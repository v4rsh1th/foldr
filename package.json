{
  "name": "foldr",
  "version": "1.0.0",
  "description": "Privacy-first PDF toolbox that runs entirely in your browser.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js --dev",
    "vendor": "node scripts/copy-vendor.js",
    "fixtures": "node tests/fixtures/generate.js",
    "test": "node --test \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run test:browser",
    "size": "node scripts/measure-size.js",
    "build": "node scripts/build.js",
    "icons": "node scripts/generate-icons.js"
  },
  "dependencies": {
    "compression": "1.8.2",
    "express": "5.3.0",
    "helmet": "8.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@playwright/test": "1.64.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.7.284"
  }
}
