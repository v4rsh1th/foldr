{
  "id": "./",
  "name": "Foldr",
  "short_name": "Foldr",
  "description": "Merge, split, organize, rotate and compress PDFs in your browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#f6f7f9",
  "theme_color": "#4f46e5",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Merge PDFs", "url": "./#/merge", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Split PDF", "url": "./#/split", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Compress PDF", "url": "./#/compress", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
